# LLM — OpenRouter (OpenAI-compatible, supports Anthropic models)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4-6

# Embeddings
EMBEDDING_PROVIDER=local_bge
COHERE_API_KEY=
OPENAI_API_KEY=

# MongoDB
MONGODB_URI=mongodb://mongo:27017/medrag

# Weaviate
WEAVIATE_URL=http://weaviate:8080

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Auth
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Admin seed user
ADMIN_EMAIL=admin@medrag-system.com
ADMIN_PASSWORD=changeme

# Service-to-service URLs (override if running outside docker-compose)
RETRIEVAL_URL=http://retrieval:8000
RERANKER_URL=http://reranker:8000
GENERATION_URL=http://generation:8000
QUERY_PROCESSOR_URL=http://query-processor:8000

@startuml seq_query
title RAG Query Flow — diagram sekwencji

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipant underline

actor User
participant "API Gateway" as GW
participant "Auth Service" as Auth
participant "Orchestrator" as Orch
participant "Query Processor" as QP
participant "Retrieval" as Retr
participant "Reranker" as RR
database "MongoDB" as Mongo
participant "Generation" as Gen
participant "LLM API" as LLM
queue "RabbitMQ" as MQ

User -> GW: POST /chat\n{query, project_id}\nHeader: Authorization JWT
GW -> Auth: validate JWT
Auth --> GW: user_id, role, project_ids

GW -> Orch: forward request
activate Orch

Orch -> QP: rewrite(query)
QP -> LLM: prompt: "rewrite this query"
LLM --> QP: rewritten query
QP --> Orch: rewritten query

Orch -> Retr: hybrid_search(query, project_id, top_k=20)
Retr -> Retr: embed query
Retr --> Orch: 20 chunk candidates

Orch -> RR: rerank(query, candidates)
RR --> Orch: top-5 reranked chunks

Orch -> Mongo: fetch full metadata\nfor chunk_ids
Mongo --> Orch: enriched chunks\n(text, document_title, page)

Orch -> Gen: generate(query, context)
activate Gen
Gen -> LLM: prompt with context\n(streaming=true)
LLM -->> Gen: token stream
Gen -->> User: SSE event stream
Gen --> Orch: complete answer + citations
deactivate Gen

Orch -> Mongo: save conversation\n(message, citations, metrics)
Orch ->> MQ: publish query.completed
note right: Eval Service\nkonsumuje asynchronicznie\nliczy RAGAS metrics\nuser już dostał odpowiedź

deactivate Orch

@enduml

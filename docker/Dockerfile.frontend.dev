FROM node:20-alpine

RUN npm install -g pnpm

WORKDIR /app

# Install deps from lockfile so the image has node_modules ready.
# The named volume in docker-compose.dev.yml shadows node_modules on the host,
# keeping container packages isolated from any local install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install

EXPOSE 3000

CMD ["pnpm", "dev", "--hostname", "0.0.0.0"]
